local TOUCH = hash("touch")

local function animate_press(node)
	gui.cancel_animations(node, gui.PROP_SCALE)

	gui.set_scale(node, vmath.vector3(0.96, 0.96, 1))

	gui.animate(
		node,
		gui.PROP_SCALE,
		vmath.vector3(1, 1, 1),
		gui.EASING_OUTBACK,
		0.18
	)
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.button_play = gui.get_node("button__play")
	self.button_settings = gui.get_node("button__settings")
	self.button_about = gui.get_node("button__about")
end

function on_input(self, action_id, action)
	if action_id ~= TOUCH or not action.pressed then
		return
	end

	local x = action.x
	local y = action.y

	if gui.pick_node(self.button_play, x, y) then
		msg.post("main:/app#controller", "show_levels")
		return true

	elseif gui.pick_node(self.button_settings, x, y) then
		msg.post("main:/app#controller", "show_settings")
		return true

	elseif gui.pick_node(self.button_about, x, y) then
		animate_press(self.button_about)
		print("About clicked")
		return true
	end
end
