local progress = require "systems.progress"
local settings = require "systems.settings"

local TOUCH = hash("touch")
local APP = "main:/app#controller"

local function show_confirmation(self, visible)
	self.confirming = visible
	gui.set_enabled(self.dialog_backdrop, visible)
	gui.set_enabled(self.dialog_confirm, visible)
end


local function update_animation_button(self)
	local enabled = settings.get_animations_enabled()
	gui.set_text(self.button_animations_label, enabled and "ANIMATIONS: ON" or "ANIMATIONS: OFF")
end


function init(self)
	msg.post(".", "acquire_input_focus")

	self.button_back = gui.get_node("settings__button__back")
	self.button_reset = gui.get_node("settings__button__reset")

	self.button_animations = gui.get_node("settings__button__animations")
	self.button_animations_label = gui.get_node("settings__button__animations__label")

	self.dialog_backdrop = gui.get_node("dialog__background")
	self.dialog_confirm = gui.get_node("reset__confirm")
	self.button_reset_cancel = gui.get_node("reset__confirm__button__cancel")
	self.button_reset_confirm = gui.get_node("reset__confirm__button__confirm")

	show_confirmation(self, false)
	update_animation_button(self)
end


function on_input(self, action_id, action)
	if action_id ~= TOUCH or not action.pressed then
		return
	end

	local x, y = action.x, action.y

	-- Confirmation dialog is active.
	if self.confirming then
		if gui.pick_node(self.button_reset_cancel, x, y) or (gui.pick_node(self.dialog_backdrop, x, y) and not gui.pick_node(self.dialog_confirm, x, y)) then
			show_confirmation(self, false)
			return true
		end

		if gui.pick_node(self.button_reset_confirm, x, y) then
			if progress.reset() then
				print("Progress reset successfully")
				show_confirmation(self, false)
			else
				print("Failed to reset progress")
			end

			return true
		end

		-- Ignore clicks outside the dialog.
		return true
	end

	-- Normal Settings screen.
	if gui.pick_node(self.button_back, x, y) then
		msg.post(APP, "show_menu")
		return true
	end

	-- Reset progress pressed
	if gui.pick_node(self.button_reset, x, y) then
		show_confirmation(self, true)
		return true
	end

	if gui.pick_node(self.button_animations, x, y) then
		local current = settings.get_animations_enabled()

		if settings.set_animations_enabled(not current) then
			update_animation_button(self)
		else
			print("Unable to save animation preference")
		end

		return true
	end
end
