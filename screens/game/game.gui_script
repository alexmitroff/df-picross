local board = require "puzzle.board"
local layout = require "puzzle.layout"
local catalog = require "levels.catalog"
local puzzles = require "levels.puzzles"
local progress = require "systems.progress"
local motion = require "systems.motion"

local TOUCH = hash("touch")
local CROSS = hash("cross")
local OPEN_LEVEL = hash("open_level")
local APP = "main:/app#controller"
local COLORS = {
	unknown = vmath.vector4(0.91, 0.94, 0.95, 1),
	filled = vmath.vector4(0.86, 0.75, 0.53, 1),
	crossed = vmath.vector4(0.91, 0.94, 0.95, 1),
	text = vmath.vector4(0.96, 0.92, 0.83, 1),
	cross = vmath.vector4(0.25, 0.39, 0.47, 1),
	separator = vmath.vector4(0.09, 0.18, 0.25, 1),
	clue_normal = vmath.vector4(0.96, 0.92, 0.83, 1),
	clue_satisfied = vmath.vector4(0.55, 0.83, 0.65, 1),
}

local function create_box(x, y, size, color)
	local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(size, size, 0))
	gui.set_color(node, color)
	gui.set_adjust_mode(node, gui.ADJUST_FIT)
	return node
end


local function create_text(x, y, value, color)
	local node = gui.new_text_node(vmath.vector3(x, y, 0),tostring(value))
	gui.set_font(node, "default")
	gui.set_color(node, color or COLORS.text)
	return node
end


local function track(self, node)
	gui.set_parent(node, self.puzzle_canvas, true)
	self.nodes[#self.nodes + 1] = node
	return node
end


local function create_grid(self)
	self.cells = {}

	local geometry = self.geometry
	local size = geometry.cell_size

	for row = 1, self.puzzle.height do
		self.cells[row] = {}

		for col = 1, self.puzzle.width do
			local x, y = layout.cell_position(geometry, row, col, self.puzzle.height)

			local cell_node = track(self, create_box(x, y, size - 1.5, COLORS.unknown))

			local cross_node = track(self, create_text(x, y, "X", COLORS.cross))
			local scale = math.min(2, math.max(0.7, size / 45))
			gui.set_scale(cross_node, vmath.vector3(scale, scale, 1))
			gui.set_enabled(cross_node, false)

			self.cells[row][col] = {
				box = cell_node,
				cross = cross_node
			}
		end
	end
end


local function create_clues(self)
	self.row_clue_nodes = {}
	self.col_clue_nodes = {}
	
	local geometry = self.geometry
	local step = geometry.clue_step

	local scale = math.min(1.0,	math.max(0.6, geometry.cell_size / 45))

	-- ROW CLUES
	for row, clues in ipairs(self.puzzle.row_clues) do
		local _, y = layout.cell_position(geometry, row, 1, self.puzzle.height)

		for index, value in ipairs(clues) do
			-- Last clue stays nearest the grid.
			local x = geometry.row_clue_right - (#clues - index) * step
			local node = track(self, create_text(x, y, value))
			gui.set_pivot(node, gui.PIVOT_E)
			gui.set_scale(node, vmath.vector3(scale, scale, 1))

			self.row_clue_nodes[row] = self.row_clue_nodes[row] or {}
			table.insert(self.row_clue_nodes[row], node)
		end
	end

	-- COLUMN CLUES
	for col, clues in ipairs(self.puzzle.col_clues) do
		local x = geometry.grid_left + (col - 0.5) * geometry.cell_size

		for index, value in ipairs(clues) do
			-- Last clue stays nearest the grid.
			local y = geometry.col_clue_bottom + (#clues - index + 0.5) * step
			local node = track(self, create_text(x, y, value))
			gui.set_scale(node, vmath.vector3(scale, scale, 1))

			self.col_clue_nodes[col] = self.col_clue_nodes[col] or {}
			table.insert(self.col_clue_nodes[col], node)
		end
	end
end


local function update_clue_nodes(nodes, satisfied)
	local color = satisfied	and COLORS.clue_satisfied or COLORS.clue_normal

	for _, node in ipairs(nodes or {}) do
		gui.set_color(node, color)
	end
end


local function update_clues(self, row, col)
	update_clue_nodes(self.row_clue_nodes[row],	board.row_clues_satisfied(self.puzzle, row))
	update_clue_nodes(self.col_clue_nodes[col], board.col_clues_satisfied(self.puzzle, col))
end


local function create_separators(self)
	local geometry = self.geometry
	local size = geometry.cell_size
	local thickness = math.max(2, size * 0.045)

	-- Vertical lines after columns 5, 10, 15...
	for col = 5, self.puzzle.width - 1, 5 do
		local x = geometry.grid_left + col * size
		local y = geometry.grid_bottom + geometry.grid_height / 2
		local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(thickness, geometry.grid_height, 0))
		gui.set_color(node, COLORS.separator)
		track(self, node)
	end

	-- Horizontal lines after rows 5, 10, 15...
	for row = 5, self.puzzle.height - 1, 5 do
		local x = geometry.grid_left + geometry.grid_width / 2
		local y = geometry.grid_bottom + (self.puzzle.height - row) * size
		local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(geometry.grid_width, thickness, 0))
		gui.set_color(node, COLORS.separator)
		track(self, node)
	end
end


local function update_cell(self, row, col)
	local cell = self.cells[row][col]
	local state = self.puzzle.cells[row][col]

	gui.set_enabled(cell.cross,	state == board.CROSSED)

	if state == board.FILLED then
		gui.set_color(cell.box, COLORS.filled)
	elseif state == board.CROSSED then
		gui.set_color(cell.box, COLORS.crossed)
	else
		gui.set_color(cell.box, COLORS.unknown)
	end
end


local function clear_grid(self)
	for _, node in ipairs(self.nodes) do
		gui.delete_node(node)
	end
	self.nodes = {}
	self.cells = {}
end


local function set_next_visible(self, visible)
	gui.set_enabled(self.button_next, visible)
	gui.set_scale( self.button_next, vmath.vector3(0.85, 0.85, 1))
	motion.animate(self.button_next, gui.PROP_SCALE, vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.25)
end


local function open_level(self, level_id)
	local level = puzzles.get(level_id)

	if not level then
		print("Unknown level:", tostring(level_id))
		return
	end

	clear_grid(self)

	self.level_id = level_id
	self.puzzle = board.create(level)

	local width = gui.get_width()
	local height = gui.get_height()
	self.geometry = layout.calculate(self.puzzle, {
		x = width * 0.05,
		y = height * 0.32,
		width = width * 0.90,
		height = height * 0.43,
		max_cell_size = 92
	})

	self.completed = false
	self.drag = nil

	gui.set_text(self.title, level.name)
	gui.set_text(self.status, "Solve the puzzle")

	self.next_level_id = nil
	set_next_visible(self, false)

	create_grid(self)
	create_separators(self)
	create_clues(self)

	print("Opened level:", level_id)
end


local function paint_cell(self, row, col, state)
	if not self.puzzle or self.completed then
		print("PAINT BLOCKED")
		return
	end

	print("PAINT:", row, col, state)

	local changed = board.set_cell(self.puzzle, row, col, state)

	print("CHANGED:", changed)
	print("CELL STATE:", self.puzzle.cells[row][col])

	if not changed then
		return
	end

	update_cell(self, row, col)
	update_clues(self, row, col)

	print("CELL COLOR:", gui.get_color(self.cells[row][col].box))


	if board.is_solved(self.puzzle) then
		self.completed = true
		self.drag = nil

		local saved = progress.complete(self.level_id)

		gui.set_text(self.status, saved and "PUZZLE COMPLETED!"	or "COMPLETED - SAVE FAILED")

		self.next_level_id = nil
		set_next_visible(self, false)

		if saved then
			local next_level, category = catalog.next_level(self.level_id)

			if next_level and progress.category_unlocked(category.id) then
				self.next_level_id = next_level.id
				set_next_visible(self, true)
			end
		end

		print("Completed:", self.level_id)
	end
end


local function find_cell(self, x, y)
	if not self.puzzle then
		print("FIND CELL: No puzzle")
		return nil, nil
	end

	for row = 1, self.puzzle.height do
		for col = 1, self.puzzle.width do
			local cell = self.cells[row][col]

			if gui.pick_node(cell.box, x, y) then
				print("FOUND CELL:", row, col)
				return row, col
			end
		end
	end

	print("FIND CELL: No matching cell", x, y)
	return nil, nil
end


local function begin_paint(self, action_id, x, y)
	print("BEGIN PAINT:", action_id, x, y)

	local row, col = find_cell(self, x, y)

	if not row or self.completed then
		return false
	end

	local mark = action_id == TOUCH	and board.FILLED or board.CROSSED

	local current = self.puzzle.cells[row][col]

	-- If the cell already has this mark, erase it.
	local target = current == mark and board.UNKNOWN or mark

	self.drag = {
		state = target,
		last_row = row,
		last_col = col,
		last_x = x,
		last_y = y,
	}

	paint_cell(self, row, col, target)

	return true
end

local function continue_paint(self, x, y)
	if not self.drag or self.completed then
		return
	end

	local drag = self.drag

	local dx = x - drag.last_x
	local dy = y - drag.last_y

	local distance = math.sqrt(dx * dx + dy * dy)

	-- Keep the sampling interval smaller than a cell.
	local spacing = math.min(12, self.geometry.cell_size / 3)

	local steps = math.max(1, math.ceil(distance / spacing))

	local start_x = drag.last_x
	local start_y = drag.last_y

	for i = 1, steps do
		local t = i / steps

		local px = start_x + dx * t
		local py = start_y + dy * t

		local row, col = find_cell(self, px, py)

		if row and (drag.last_row ~= row or drag.last_col ~= col) then
			drag.last_row = row
			drag.last_col = col

			paint_cell(self, row, col, drag.state)

			-- Victory can end the gesture.
			if self.completed then
				break
			end
		end
	end

	if self.drag then
		self.drag.last_x = x
		self.drag.last_y = y
	end
end


function init(self)
	msg.post(".", "acquire_input_focus")

	self.title = gui.get_node("title")
	self.status = gui.get_node("status")
	self.button_back = gui.get_node("button__back")
	self.button_next = gui.get_node("button__next")
	self.puzzle_canvas = gui.get_node("puzzle__canvas")

	self.next_level_id = nil
	set_next_visible(self, false)

	self.nodes = {}
	self.cells = {}

	self.puzzle = nil
	self.level_id = nil
	self.completed = false
	self.drag = nil
end

function on_message(self, message_id, message, sender)
	if message_id == OPEN_LEVEL then
		open_level(self, message.level_id)
	end
end

function on_input(self, action_id, action)
	if action.pressed and self.puzzle then
		local node = self.cells[1][1].box
		local pos = gui.get_position(node)
		local size = gui.get_size(node)

		print("GUI:", gui.get_width(), gui.get_height())
		print("INPUT:", action.x, action.y)
		print("CELL POSITION:", pos.x, pos.y)
		print("CELL SIZE:", size.x, size.y)
		print("PICK AT CENTER:",gui.pick_node(node, pos.x, pos.y))
		print("PICK AT MOUSE:",	gui.pick_node(node, action.x, action.y))
	end
	-- Pointer movement during a drag.
	if action_id == nil then
		if self.drag and action.x and action.y then
			continue_paint(self, action.x, action.y)
		end
		return
	end

	if action_id ~= TOUCH and action_id ~= CROSS then
		return
	end

	-- Stop painting on mouse release.
	if action.released then
		self.drag = nil
		return true
	end

	if not action.pressed then
		return
	end

	local x, y = action.x, action.y

	-- The Back button only responds to left click.
	if action_id == TOUCH and gui.pick_node(self.button_back, x, y) then
		msg.post(APP, "show_levels")
		return true
	end

	-- The `Next puzzle` button
	if action_id == TOUCH and self.next_level_id and gui.is_enabled(self.button_next) and gui.pick_node(self.button_next, x, y) then
		local level_id = self.next_level_id
		open_level(self, level_id)
		return true
	end

	if self.drag then
		return true
	end

	-- Begin filling or crossing cells.
	return begin_paint(self, action_id, x, y)
end
