
local TOUCH = hash("touch")
local APP = "main:/app#controller"

function init(self)
	msg.post(".", "acquire_input_focus")
	self.title = gui.get_node("title")
	self.instruction = gui.get_node("instruction")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("open_level") then
		self.level_id = message.level_id
		gui.set_text(self.title,"LEVEL: " .. self.level_id)
		gui.set_text(self.instruction,"CLICK TO RETURN")
		print("Opening level:", self.level_id)
	end
end

function on_input(self, action_id, action)
	if action_id == TOUCH and action.pressed then
		msg.post(APP, "show_levels")
		return true
	end
end
