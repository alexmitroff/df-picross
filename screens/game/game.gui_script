local puzzles = require "levels.puzzles"

local board = require "puzzle.board"
local layout = require "puzzle.layout"

local progress = require "systems.progress"
local session = require "systems.session"
local viewport = require "systems.viewport"

local TOUCH = hash("touch")
local CROSS = hash("cross")
local PAN = hash("pan")
local ZOOM_IN = hash("zoom_in")
local ZOOM_OUT = hash("zoom_out")
local MULTITOUCH = hash("multitouch")

local OPEN_LEVEL = hash("open_level")
local LAYOUT_CHANGED = hash("layout_changed")

local APP = "main:/app#controller"
local COLORS = {
	unknown = vmath.vector4(0.91, 0.94, 0.95, 1),
	filled = vmath.vector4(0.86, 0.75, 0.53, 1),
	crossed = vmath.vector4(0.91, 0.94, 0.95, 1),
	text = vmath.vector4(0.96, 0.92, 0.83, 1),
	cross = vmath.vector4(0.25, 0.39, 0.47, 1),
	separator = vmath.vector4(0.09, 0.18, 0.25, 1),
	clue_normal = vmath.vector4(0.96, 0.92, 0.83, 1),
	clue_satisfied = vmath.vector4(0.55, 0.83, 0.65, 1),
}


local function create_box(x, y, size, color)
	local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(size, size, 0))
	gui.set_color(node, color)
	gui.set_adjust_mode(node, gui.ADJUST_FIT)
	return node
end


local function create_text(x, y, value, color)
	local node = gui.new_text_node(vmath.vector3(x, y, 0),tostring(value))
	gui.set_font(node, "default")
	gui.set_color(node, color or COLORS.text)
	return node
end


local function track(self, node, parent)
	gui.set_parent(node, parent, false)
	self.nodes[#self.nodes + 1] = node
	return node
end


local function create_clue_container(self, parent, x, y)
	local node = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(1, 1, 0))
	gui.set_pivot(node, gui.PIVOT_SW)
	gui.set_visible(node, false)
	track(self, node, parent)
	gui.set_position(node, vmath.vector3(x, y, 0))
	return node
end


local CELL_TEXTURE = "cells"

local CELL_IMAGES = {
	[board.UNKNOWN] = "cell_unknown",
	[board.FILLED] = "cell_filled",
	[board.CROSSED] = "cell_crossed"
}

local function create_grid(self)
	self.cells = {}

	local puzzle = self.session.board
	local geometry = self.geometry

	for row = 1, puzzle.height do
		self.cells[row] = {}

		for col = 1, puzzle.width do
			local x, y = layout.cell_position(geometry, row, col, puzzle.height)

			local node = create_box(0, 0, geometry.visual_cell_size, vmath.vector4(1, 1, 1, 1))

			gui.set_texture(node, CELL_TEXTURE)
			gui.play_flipbook(node, CELL_IMAGES[board.UNKNOWN])
			track(self, node, self.grid_content)
			gui.set_position(node, vmath.vector3(x, y, 0))
			self.cells[row][col] = node
		end
	end
end


local function create_clues(self)
	self.row_containers = {}
	self.col_containers = {}

	self.row_clue_nodes = {}
	self.col_clue_nodes = {}

	local step = self.geometry.clue_step

	-- ROW CLUES
	for row, clues in ipairs(self.session.board.row_clues) do
		local _, y = layout.cell_position(self.geometry, row, 1, self.session.board.height)
		local container = create_clue_container(self, self.rows_content, 0, y)
		self.row_containers[row] = container
		self.row_clue_nodes[row] = {}

		for index, value in ipairs(clues) do
			local x = self.geometry.row_clue_right - (#clues - index) * step
			local node = track(	self,create_text(0, 0, value), container)
			gui.set_position(node, vmath.vector3(x, 0, 0))
			gui.set_pivot(node, gui.PIVOT_E)
			self.row_clue_nodes[row][index] = node
		end
	end

	-- COLUMN CLUES
	for col, clues in ipairs(self.session.board.col_clues) do
		local x, _ = layout.cell_position(self.geometry, 1, col, self.session.board.height)
		local container = create_clue_container(self, self.columns_content, x, 0)
		self.col_containers[col] = container
		self.col_clue_nodes[col] = {}

		for index, value in ipairs(clues) do
			local y = self.geometry.col_clue_bottom + (#clues - index + 0.5) * step
			local node = track(	self, create_text(0, 0, value),	container)
			gui.set_position(node, vmath.vector3(0, y, 0))
			self.col_clue_nodes[col][index] = node
		end
	end
end


local function update_clue_nodes(nodes, satisfied)
	local color = satisfied	and COLORS.clue_satisfied or COLORS.clue_normal
	for _, node in ipairs(nodes or {}) do gui.set_color(node, color) end
end


local function update_clues(self, row, col)
	update_clue_nodes(self.row_clue_nodes[row],	board.row_clues_satisfied(self.session.board, row))
	update_clue_nodes(self.col_clue_nodes[col], board.col_clues_satisfied(self.session.board, col))
end



local function update_clue_text_scales(self)
	if not self.geometry or not self.viewport then	return end

	local base_scale = math.min(1, self.geometry.clue_step / 20)
	local target_scale = base_scale / self.viewport.zoom

	for _, nodes in pairs(self.row_clue_nodes) do
		for _, node in ipairs(nodes) do
			gui.set_scale(node,	vmath.vector3(base_scale, target_scale, 1))
		end
	end

	for _, nodes in pairs(self.col_clue_nodes) do
		for _, node in ipairs(nodes) do
			gui.set_scale(node, vmath.vector3(target_scale, base_scale, 1))
		end
	end
end


local function update_cell(self, row, col)
	local node = self.cells[row][col]
	local state = self.session.board.cells[row][col]
	gui.play_flipbook(node, CELL_IMAGES[state])
end


local function clear_grid(self)
	for _, node in ipairs(self.nodes) do gui.delete_node(node) end
	self.nodes = {}
	self.cells = {}
	self.row_containers = {}
	self.col_containers = {}
	self.row_clue_nodes = {}
	self.col_clue_nodes = {}
end


local function clue_text_size(node)
	local font_name = gui.get_font(node)
	local font_resource = gui.get_font_resource(font_name)
	local metrics = resource.get_text_metrics(font_resource, gui.get_text(node))
	local scale = gui.get_scale(node)

	return metrics.width * scale.x, metrics.height * scale.y
end



local function clue_scroll_limits(self)
	local geometry = self.geometry
	local padding = math.max(4, geometry.clue_step * 0.5)

	local columns_size = gui.get_size(self.columns_viewport)

	-- Find the actual leftmost edge of all row clues.
	local leftmost = math.huge

	for _, nodes in pairs(self.row_clue_nodes) do
		for _, node in ipairs(nodes) do
			local pos = gui.get_position(node)
			local width = clue_text_size(node)

			-- Row clues use PIVOT_E (right-aligned).
			local left = pos.x - width
			leftmost = math.min(leftmost, left)
		end
	end

	-- Find the actual topmost edge of all column clues.
	local topmost = -math.huge

	for _, nodes in pairs(self.col_clue_nodes) do
		for _, node in ipairs(nodes) do
			local pos = gui.get_position(node)
			local _, height = clue_text_size(node)

			-- Column clues use the default center pivot.
			local top = pos.y + height / 2
			topmost = math.max(topmost, top)
		end
	end

	local max_rows_x = 0
	if leftmost < math.huge then
		max_rows_x = math.max(0, padding - leftmost)
	end

	local min_columns_y = 0
	if topmost > -math.huge then
		min_columns_y = math.min(0, columns_size.y - padding - topmost)
	end

	return {
		rows_min = 0,
		rows_max = max_rows_x,
		columns_min = min_columns_y,
		columns_max = 0
	}
end


local function clamp_clue_scroll(self)
	if not self.session or not self.geometry then return end

	local limits = clue_scroll_limits(self)
	local scroll = self.clue_scroll
	scroll.rows_x = math.max(limits.rows_min, math.min(limits.rows_max, scroll.rows_x))
	scroll.columns_y = math.max(limits.columns_min,math.min(limits.columns_max, scroll.columns_y))
end


local function calculate_geometry(self)
	local puzzle = self.session.board

	local grid_size = gui.get_size(self.grid_viewport)
	local rows_size = gui.get_size(self.rows_viewport)

	self.geometry = layout.calculate_grid(puzzle, {
		width = grid_size.x,
		height = grid_size.y,
		max_cell_size = 92
	})

	local padding = math.max(4, self.geometry.clue_step * 0.5)
	self.geometry.row_clue_right = rows_size.x - padding
	self.geometry.col_clue_bottom = padding
end


local function rebuild_board(self)
	if not self.session then return	end

	self.drag = nil

	clear_grid(self)

	local puzzle = self.session.board

	calculate_geometry(self)
	create_grid(self)
	create_clues(self)

	-- Restore painted cells
	for row = 1, puzzle.height do
		for col = 1, puzzle.width do
			update_cell(self, row, col)
		end
	end

	-- Restore clue highlighting
	for row = 1, puzzle.height do
		update_clue_nodes(self.row_clue_nodes[row],	board.row_clues_satisfied(self.session.board, row))
	end

	for col = 1, puzzle.width do
		update_clue_nodes(self.col_clue_nodes[col],	board.col_clues_satisfied(self.session.board, col))
	end

	update_clue_text_scales(self)
end


local function update_board_layout(self)
	if not self.session then return	end

	self.drag = nil
	local puzzle = self.session.board

	calculate_geometry(self)
	local geometry = self.geometry

	-- Reposition and resize existing cells.
	for row = 1, puzzle.height do
		for col = 1, puzzle.width do
			local node = self.cells[row][col]
			local x, y = layout.cell_position(geometry, row, col, puzzle.height)
			gui.set_position(node, vmath.vector3(x, y, 0))
			gui.set_size(node, vmath.vector3(geometry.visual_cell_size, geometry.visual_cell_size, 0))
		end
	end

	-- Reposition existing row clues.
	for row, clues in ipairs(puzzle.row_clues) do
		local _, y = layout.cell_position(geometry, row, 1, puzzle.height)
		for index, node in ipairs(self.row_clue_nodes[row] or {}) do
			local x = geometry.row_clue_right - (#clues - index) * geometry.clue_step
			gui.set_position(node, vmath.vector3(x, y, 0))
		end
	end

	-- Reposition existing column clues.
	for col, clues in ipairs(puzzle.col_clues) do
		local x, _ = layout.cell_position(geometry, 1, col, puzzle.height)
		for index, node in ipairs(self.col_clue_nodes[col] or {}) do
			local y = geometry.col_clue_bottom + (#clues - index + 0.5) * geometry.clue_step
			gui.set_position(node, vmath.vector3(x, y, 0))
		end
	end

	update_clue_text_scales(self)
end


local PUZZLE_STATUS_TEXT = {
	playing = "Solve the puzzle",
	completed = "Completed!",
	save_failed = "Completed! Progress not saved.",
	game_completed = "Game completed!"
}

local function sync_ui(self)
	if not self.session then return	end

	local s = self.session
	gui.set_text(self.title, s.level.title)
	gui.set_text(self.status, PUZZLE_STATUS_TEXT[s.ui.status] or "")
	gui.set_enabled(self.button_next, s.ui.show_next)
end


local function touch_in_viewport(viewport_node, touch)
	local p = gui.screen_to_local(viewport_node, vmath.vector3(touch.screen_x, touch.screen_y, 0))
	return p.x, p.y
end


local function touch_position(self, touch)
	return touch_in_viewport(self.grid_viewport, touch)
end


local function touch_pair(self, first, second)
	local x1, y1 = touch_position(self, first)
	local x2, y2 = touch_position(self, second)
	local center_x = (x1 + x2) / 2
	local center_y = (y1 + y2) / 2

	local dx = x2 - x1
	local dy = y2 - y1
	local distance = math.sqrt(dx * dx + dy * dy)

	return center_x, center_y, distance
end


local function apply_viewport(self)
	local v = self.viewport
	local z = v.zoom

	gui.set_position(self.grid_content,	vmath.vector3(v.pan_x, v.pan_y, 0))
	gui.set_scale(self.grid_content,vmath.vector3(z, z, 1))

	gui.set_position(self.rows_content, vmath.vector3(self.clue_scroll.rows_x, v.pan_y,	0))
	gui.set_scale(self.rows_content, vmath.vector3(1, z, 1))

	gui.set_position(self.columns_content, vmath.vector3(v.pan_x, self.clue_scroll.columns_y, 0))
	gui.set_scale(self.columns_content, vmath.vector3(z, 1, 1))

	update_clue_text_scales(self)
end


local function reset_viewport(self)
	if not self.geometry then return end

	local size = gui.get_size(self.grid_viewport)
	viewport.reset(self.viewport, self.geometry, size.x, size.y)
	apply_viewport(self)
end



local function scroll_clues(self, direction, x, y)
	if not self.session or not self.geometry then return false end

	local step = math.max(12, self.geometry.clue_step * 2)

	if gui.pick_node(self.rows_viewport, x, y) then
		self.clue_scroll.rows_x = self.clue_scroll.rows_x + direction * step
	elseif gui.pick_node(self.columns_viewport, x, y) then
		self.clue_scroll.columns_y = self.clue_scroll.columns_y + direction * step
	else
		return false
	end

	clamp_clue_scroll(self)
	apply_viewport(self)

	return true
end



local function grid_pointer_position(self, action)
	local pos = gui.screen_to_local(self.grid_viewport,	vmath.vector3(action.screen_x, action.screen_y, 0))
	return pos.x, pos.y
end


local function zoom_viewport(self, action, direction)
	if not self.session or self.session.completed then return false	end
	if not action.screen_x or not action.screen_y then return false end
	if not gui.pick_node(self.grid_viewport, action.x, action.y) then return false end

	local x, y = grid_pointer_position(self, action)
	local size = gui.get_size(self.grid_viewport)
	viewport.zoom_step(self.viewport, direction, x, y, self.geometry, size.x, size.y)
	apply_viewport(self)
	return true
end


local function begin_pan(self, action)
	if not self.session or self.session.completed then return false	end
	if not gui.pick_node(self.grid_viewport, action.x, action.y) then return false end

	self.drag = nil
	self.panning = true

	self.last_pan_x, self.last_pan_y = grid_pointer_position(self, action)

	return true
end


local function continue_pan(self, action)
	if not self.panning or not self.session then return end

	local x, y = grid_pointer_position(self, action)

	local dx = x - self.last_pan_x
	local dy = y - self.last_pan_y

	local size = gui.get_size(self.grid_viewport)
	viewport.pan(self.viewport, dx, dy, self.geometry, size.x, size.y)

	self.last_pan_x = x
	self.last_pan_y = y

	apply_viewport(self)
end


local TOUCH_MODES = {
	idle = "idle",
	navigation = "navigation",
	blocked = "blocked",
	painting = "painting",
	scroll_rows = "scroll_rows",
	scroll_columns = "scroll_columns",
}

local function open_level(self, category_index, level_index)
	if not puzzles.get(category_index, level_index) then
		print("Unknown puzzle:", tostring(category_index), tostring(level_index))
		return false
	end

	self.drag = nil
	self.panning = false

	self.touch_gesture.mode = TOUCH_MODES.idle
	self.touch_gesture.last_x = nil
	self.touch_gesture.last_y = nil
	self.touch_gesture.last_distance = nil

	clear_grid(self)

	-- Release the previous session.
	self.session = nil
	self.geometry = nil

	-- Schedule the new puzzle.
	self.pending_category_index = category_index
	self.pending_level_index = level_index
	self.pending_level_frames = 3

	gui.set_enabled(self.button_next, false)
	gui.set_text(self.title, "Loading...")
	gui.set_text(self.status, "")

	return true
end



local function load_pending_level(self)
	local category_index = self.pending_category_index
	local level_index = self.pending_level_index

	if not category_index or not level_index then return end

	self.pending_category_index = nil
	self.pending_level_index = nil
	self.pending_level_frames = nil

	self.session = session.new(category_index, level_index)

	rebuild_board(self)

	self.clue_scroll.rows_x = 0
	self.clue_scroll.columns_y = 0

	reset_viewport(self)
	sync_ui(self)

	print("Opened puzzle:",	category_index,	level_index)
end


local function paint_cell(self, row, col, state)
	if not self.session then return	end

	local result = session.paint(self.session, row,	col, state)
	if not result.changed then return end

	update_cell(self, row, col)
	update_clues(self, row, col)

	if result.completed_now then
		local s = self.session
		local saved = progress.complete(s.category_index, s.level_index)
		local can_advance = false

		if saved and s.next_category_index then
			can_advance = progress.is_category_unlocked(s.next_category_index)
		end

		session.finish(s, saved, can_advance)
		reset_viewport(self)
		sync_ui(self)

		self.drag = nil
	end
end


local function find_cell(self, x, y)
	if not self.session or not self.session.board then return nil, nil end
	if not gui.pick_node(self.grid_viewport, x, y) then	return nil, nil	end

	for row = 1, self.session.board.height do
		for col = 1, self.session.board.width do
			local cell = self.cells[row][col]

			if gui.pick_node(cell, x, y) then
				return row, col
			end
		end
	end
	return nil, nil
end


local function begin_paint(self, action_id, x, y)

	local row, col = find_cell(self, x, y)

	if not row or self.session.completed then return false end

	local mark = action_id == TOUCH	and board.FILLED or board.CROSSED

	local current = self.session.board.cells[row][col]

	-- If the cell already has this mark, erase it.
	local target = current == mark and board.UNKNOWN or mark

	self.drag = {
		state = target,
		last_row = row,
		last_col = col,
		last_x = x,
		last_y = y,
	}

	paint_cell(self, row, col, target)
	return true
end


local function continue_paint(self, x, y)
	if not self.drag or self.session.completed then return end

	local drag = self.drag

	local dx = x - drag.last_x
	local dy = y - drag.last_y

	local distance = math.sqrt(dx * dx + dy * dy)

	-- Keep the sampling interval smaller than a cell.
	local spacing = math.min(12, self.geometry.cell_size / 3)

	local steps = math.max(1, math.ceil(distance / spacing))

	local start_x = drag.last_x
	local start_y = drag.last_y

	for i = 1, steps do
		local t = i / steps

		local px = start_x + dx * t
		local py = start_y + dy * t

		local row, col = find_cell(self, px, py)

		if row and (drag.last_row ~= row or drag.last_col ~= col) then
			drag.last_row = row
			drag.last_col = col

			paint_cell(self, row, col, drag.state)

			-- Victory can end the gesture.
			if self.session.completed then break end
		end
	end

	if self.drag then
		self.drag.last_x = x
		self.drag.last_y = y
	end
end


local function tap_cell(self, x, y)
	local row, col = find_cell(self, x, y)

	if not row then return false end

	local current_state = self.session.board.cells[row][col]
	local next_state = board.next_state(current_state)

	paint_cell(self, row, col, next_state)
	return true
end


local function begin_clue_swipe(self, touch, mode)
	self.drag = nil
	local viewport_node = mode == TOUCH_MODES.scroll_rows and self.rows_viewport or self.columns_viewport

	local gesture = self.touch_gesture
	gesture.mode = mode
	gesture.last_distance = nil
	gesture.last_x, gesture.last_y = touch_in_viewport(viewport_node, touch)
end


local function continue_clue_swipe(self, touch)
	local gesture = self.touch_gesture

	local viewport_node = gesture.mode == TOUCH_MODES.scroll_rows and self.rows_viewport or self.columns_viewport

	local x, y = touch_in_viewport(viewport_node, touch)
	local dx = x - gesture.last_x
	local dy = y - gesture.last_y
	gesture.last_x = x
	gesture.last_y = y

	if gesture.mode == TOUCH_MODES.scroll_rows then
		self.clue_scroll.rows_x = self.clue_scroll.rows_x + dx
	elseif gesture.mode == TOUCH_MODES.scroll_columns then
		self.clue_scroll.columns_y = self.clue_scroll.columns_y + dy
	end

	clamp_clue_scroll(self)
	apply_viewport(self)
end


local function handle_multitouch(self, action)
	if not self.session or self.pending_category_index then return false end

	local gesture = self.touch_gesture

	-- Collect touches that have not been released.
	local touches = {}

	for _, touch in ipairs(action.touch or {}) do
		if not touch.released then
			touches[#touches + 1] = touch
		end
	end

	table.sort(touches, function(a, b) return a.id < b.id end)

	local count = #touches

	-- All fingers released: ready for a new gesture.
	if count == 0 then
		self.drag = nil
		gesture.mode = TOUCH_MODES.idle
		gesture.last_x = nil
		gesture.last_y = nil
		gesture.last_distance = nil
		return true
	end

	-- Two or more fingers: navigation mode.
	if count >= 2 then
		self.drag = nil

		if gesture.mode == TOUCH_MODES.scroll_rows or gesture.mode == TOUCH_MODES.scroll_columns then
			gesture.mode = TOUCH_MODES.blocked
			return true
		end

		if gesture.mode ~= TOUCH_MODES.navigation then
			if gesture.mode == TOUCH_MODES.blocked then return true end

			local first = touches[1]
			local second = touches[2]

			if not (gui.pick_node(self.grid_viewport, first.x, first.y)	and gui.pick_node(self.grid_viewport, second.x, second.y)) then
				gesture.mode = TOUCH_MODES.blocked
				self.drag = nil
				return true
			end
		end

		local x, y, distance = touch_pair(self, touches[1], touches[2])

		if gesture.mode == TOUCH_MODES.navigation then
			local size = gui.get_size(self.grid_viewport)
			viewport.gesture(self.viewport, gesture.last_x, gesture.last_y,	gesture.last_distance, x, y, distance, self.geometry, size.x, size.y)
			apply_viewport(self)
		end

		gesture.mode = TOUCH_MODES.navigation
		gesture.last_x = x
		gesture.last_y = y
		gesture.last_distance = distance

		return true
	end

	-- One finger remains after navigation.
	-- Don't resume painting until all fingers are lifted.
	if gesture.mode == TOUCH_MODES.navigation or gesture.mode == TOUCH_MODES.blocked then
		self.drag = nil
		gesture.mode = TOUCH_MODES.blocked
		return true
	end

	-- One-finger painting.
	local touch = touches[1]

	if gesture.mode == TOUCH_MODES.scroll_rows or gesture.mode == TOUCH_MODES.scroll_columns then
		continue_clue_swipe(self, touch)
		return true
	end

	if gesture.mode == TOUCH_MODES.idle and touch.pressed then

		-- Back button
		if gui.pick_node(self.button_back, touch.x, touch.y) then
			msg.post(APP, "show_levels")
			gesture.mode = TOUCH_MODES.blocked
			return true
		end

		-- Next puzzle button
		if self.session.ui.show_next and self.session.next_category_index and self.session.next_level_index
		and gui.pick_node(self.button_next, touch.x, touch.y) then
			open_level(self, self.session.next_category_index, self.session.next_level_index)
			return true
		end

		-- Row clues: horizontal scrolling
		if gui.pick_node(self.rows_viewport, touch.x, touch.y) then
			begin_clue_swipe(self, touch, TOUCH_MODES.scroll_rows)
			return true
		end

		-- Column clues: vertical scrolling
		if gui.pick_node(self.columns_viewport, touch.x, touch.y) then
			begin_clue_swipe(self, touch, TOUCH_MODES.scroll_columns)
			return true
		end

		-- Grid: cycle cell state
		if gui.pick_node(self.grid_viewport, touch.x, touch.y) then
			tap_cell(self, touch.x, touch.y)
			gesture.mode = TOUCH_MODES.painting
			return true
		end
	end

	return true
end


function init(self)
	msg.post(".", "acquire_input_focus")

	self.last_gui_width = gui.get_width()
	self.last_gui_height = gui.get_height()

	self.title = gui.get_node("title")
	self.status = gui.get_node("status")
	self.button_back = gui.get_node("button__back")
	self.button_next = gui.get_node("button__next")
	self.puzzle_canvas = gui.get_node("puzzle")
	self.grid_viewport = gui.get_node("puzzle__grid")
	self.grid_content =	gui.get_node("puzzle__grid__content")
	self.rows_viewport = gui.get_node("puzzle__rows")
	self.rows_content =	gui.get_node("puzzle__rows__content")
	self.columns_viewport =	gui.get_node("puzzle__columns")
	self.columns_content = gui.get_node("puzzle__columns__content")

	self.nodes = {}
	self.cells = {}

	self.pending_category_index = nil
	self.pending_level_index = nil
	self.pending_level_frames = nil

	self.session = nil
	self.drag = nil

	self.viewport = viewport.new()
	self.panning = false
	self.last_pan_x = nil
	self.last_pan_y = nil

	self.clue_scroll = {
		rows_x = 0,
		columns_y = 0
	}

	self.touch_gesture = {
		mode = TOUCH_MODES.idle,
		last_x = nil,
		last_y = nil,
		last_distance = nil
	}
end


function update(self, dt)
	if self.pending_category_index then
		self.pending_level_frames =	self.pending_level_frames - 1
		if self.pending_level_frames <= 0 then load_pending_level(self)	end
		return
	end

	local width = gui.get_width()
	local height = gui.get_height()
	if width ~= self.last_gui_width	or height ~= self.last_gui_height then
		self.last_gui_width = width
		self.last_gui_height = height
		update_board_layout(self)
		if self.session then
			local size = gui.get_size(self.grid_viewport)
			viewport.clamp(self.viewport, self.geometry, size.x, size.y)
			apply_viewport(self)
		end
		sync_ui(self)
	end
end


function on_message(self, message_id, message, sender)
	if message_id == OPEN_LEVEL then
		open_level(self, message.category_index, message.level_index)
	elseif message_id == LAYOUT_CHANGED and not self.pending_category_index then
		update_board_layout(self)
		if self.session then
			local size = gui.get_size(self.grid_viewport)
			viewport.clamp(self.viewport, self.geometry, size.x, size.y)
			clamp_clue_scroll(self)
			apply_viewport(self)
		end
		sync_ui(self)
	end
end

function on_input(self, action_id, action)
	-- Pointer movement during a drag.
	if action_id == nil then
		if self.panning and action.screen_x and action.screen_y then
			continue_pan(self, action)
		elseif self.drag and action.x and action.y then
			continue_paint(self, action.x, action.y)
		end
		return
	end

	if action_id == MULTITOUCH then
		return handle_multitouch(self, action)
	end

	if action_id == ZOOM_IN or action_id == ZOOM_OUT then
		if action.value == 0 then return false end

		local direction = action_id == ZOOM_IN and 1 or -1
		if scroll_clues(self, direction, action.x, action.y) then return true end
		return zoom_viewport(self, action, direction)
	end

	if action_id == PAN then
		if action.pressed then return begin_pan(self, action) end
		if action.released then
			self.panning = false
			return true
		end
		return
	end

	if action_id ~= TOUCH and action_id ~= CROSS then
		return
	end

	-- Stop painting on mouse release.
	if action.released then
		self.drag = nil
		return true
	end

	if not action.pressed then return end

	local x, y = action.x, action.y

	-- The Back button only responds to left click.
	if action_id == TOUCH and gui.pick_node(self.button_back, x, y) then
		msg.post(APP, "show_levels")
		return true
	end

	-- If session does not exist we do not need the rest
	if not self.session then return false end

	-- The `Next puzzle` button
	if action_id == TOUCH and self.session.ui.show_next	and self.session.next_category_index and self.session.next_level_index
	and gui.pick_node(self.button_next, x, y) then
		return open_level(self, self.session.next_category_index, self.session.next_level_index)
	end

	if self.drag then return true end

	-- Begin filling or crossing cells.
	return begin_paint(self, action_id, x, y)
end
