local catalog = require "levels.catalog"
local puzzles = require "levels.puzzles"

local board = require "puzzle.board"
local layout = require "puzzle.layout"

local progress = require "systems.progress"
local session = require "systems.session"

local TOUCH = hash("touch")
local CROSS = hash("cross")
local OPEN_LEVEL = hash("open_level")
local LAYOUT_CHANGED = hash("layout_changed")

local APP = "main:/app#controller"
local COLORS = {
	unknown = vmath.vector4(0.91, 0.94, 0.95, 1),
	filled = vmath.vector4(0.86, 0.75, 0.53, 1),
	crossed = vmath.vector4(0.91, 0.94, 0.95, 1),
	text = vmath.vector4(0.96, 0.92, 0.83, 1),
	cross = vmath.vector4(0.25, 0.39, 0.47, 1),
	separator = vmath.vector4(0.09, 0.18, 0.25, 1),
	clue_normal = vmath.vector4(0.96, 0.92, 0.83, 1),
	clue_satisfied = vmath.vector4(0.55, 0.83, 0.65, 1),
}


local function create_box(x, y, size, color)
	local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(size, size, 0))
	gui.set_color(node, color)
	gui.set_adjust_mode(node, gui.ADJUST_FIT)
	return node
end


local function create_text(x, y, value, color)
	local node = gui.new_text_node(vmath.vector3(x, y, 0),tostring(value))
	gui.set_font(node, "default")
	gui.set_color(node, color or COLORS.text)
	return node
end


local function track(self, node)
	gui.set_parent(node, self.puzzle_canvas, false)
	self.nodes[#self.nodes + 1] = node
	return node
end



local CELL_TEXTURE = "cells"

local CELL_IMAGES = {
	[board.UNKNOWN] = "cell_unknown",
	[board.FILLED] = "cell_filled",
	[board.CROSSED] = "cell_crossed"
}

local function create_grid(self)
	self.cells = {}

	local puzzle = self.session.board
	local geometry = self.geometry

	for row = 1, puzzle.height do
		self.cells[row] = {}

		for col = 1, puzzle.width do
			local x, y = layout.cell_position(geometry, row, col, puzzle.height)
			local node = create_box(x, y, math.max(0.1, geometry.visual_cell_size), vmath.vector4(1, 1, 1, 1))
			gui.set_texture(node, CELL_TEXTURE)
			gui.play_flipbook(node, CELL_IMAGES[board.UNKNOWN])
			track(self, node)
			self.cells[row][col] = node
		end
	end
end


local function create_clues(self)
	self.row_clue_nodes = {}
	self.col_clue_nodes = {}
	
	local geometry = self.geometry
	local step = geometry.clue_step
	local scale = math.min(1.0,	math.max(0.6, geometry.cell_size / 45))

	-- ROW CLUES
	for row, clues in ipairs(self.session.board.row_clues) do
		local _, y = layout.cell_position(geometry, row, 1, self.session.board.height)

		for index, value in ipairs(clues) do
			-- Last clue stays nearest the grid.
			local x = geometry.row_clue_right - (#clues - index) * step
			local node = track(self, create_text(x, y, value))
			gui.set_pivot(node, gui.PIVOT_E)
			gui.set_scale(node, vmath.vector3(scale, scale, 1))

			self.row_clue_nodes[row] = self.row_clue_nodes[row] or {}
			table.insert(self.row_clue_nodes[row], node)
		end
	end

	-- COLUMN CLUES
	for col, clues in ipairs(self.session.board.col_clues) do
		local x = select(1, layout.cell_position(geometry, 1, col, self.session.board.height))

		for index, value in ipairs(clues) do
			-- Last clue stays nearest the grid.
			local y = geometry.col_clue_bottom + (#clues - index + 0.5) * step
			local node = track(self, create_text(x, y, value))
			gui.set_scale(node, vmath.vector3(scale, scale, 1))

			self.col_clue_nodes[col] = self.col_clue_nodes[col] or {}
			table.insert(self.col_clue_nodes[col], node)
		end
	end
end


local function update_clue_nodes(nodes, satisfied)
	local color = satisfied	and COLORS.clue_satisfied or COLORS.clue_normal
	for _, node in ipairs(nodes or {}) do gui.set_color(node, color) end
end


local function update_clues(self, row, col)
	update_clue_nodes(self.row_clue_nodes[row],	board.row_clues_satisfied(self.session.board, row))
	update_clue_nodes(self.col_clue_nodes[col], board.col_clues_satisfied(self.session.board, col))
end


local function update_cell(self, row, col)
	local node = self.cells[row][col]
	local state = self.session.board.cells[row][col]
	gui.play_flipbook(node, CELL_IMAGES[state])
end


local function clear_grid(self)
	for _, node in ipairs(self.nodes) do gui.delete_node(node) end
	self.nodes = {}
	self.cells = {}
	self.row_clue_nodes = {}
	self.col_clue_nodes = {}
end


local function rebuild_board(self)
	if not self.session then return	end

	self.drag = nil

	clear_grid(self)

	local puzzle = self.session.board
	local size = gui.get_size(self.puzzle_canvas)

	self.geometry = layout.calculate(puzzle, {
		x = -size.x / 2,
		y = -size.y / 2,
		width = size.x,
		height = size.y,
		max_cell_size = 92
	})

	create_grid(self)
	create_clues(self)

	-- Restore painted cells
	for row = 1, puzzle.height do
		for col = 1, puzzle.width do
			update_cell(self, row, col)
		end
	end

	-- Restore clue highlighting
	for row = 1, puzzle.height do
		update_clue_nodes(self.row_clue_nodes[row],	board.row_clues_satisfied(self.session.board, row))
	end

	for col = 1, puzzle.width do
		update_clue_nodes(self.col_clue_nodes[col],	board.col_clues_satisfied(self.session.board, col))
	end
end



local function update_board_layout(self)
	if not self.session then return	end

	self.drag = nil

	local puzzle = self.session.board
	local canvas_size = gui.get_size(self.puzzle_canvas)

	self.geometry = layout.calculate(puzzle, {
		x = -canvas_size.x / 2,
		y = -canvas_size.y / 2,
		width = canvas_size.x,
		height = canvas_size.y,
		max_cell_size = 92
	})

	local g = self.geometry
	local size = g.cell_size

	-- Reposition and resize existing cells.
	for row = 1, puzzle.height do
		for col = 1, puzzle.width do
			local node = self.cells[row][col]
			local x, y = layout.cell_position(g, row, col, puzzle.height)
			gui.set_position(node, vmath.vector3(x, y, 0))
			gui.set_size(node, vmath.vector3(g.visual_cell_size, g.visual_cell_size, 0))
		end
	end

	-- Reposition existing row clues.
	local clue_scale = math.min(1, g.clue_step / 20)
	for row, clues in ipairs(puzzle.row_clues) do
		local _, y = layout.cell_position(g, row, 1, puzzle.height)
		for index, node in ipairs(self.row_clue_nodes[row] or {}) do
			local x = g.row_clue_right - (#clues - index) * g.clue_step
			gui.set_position(node, vmath.vector3(x, y, 0))
			gui.set_scale(node,	vmath.vector3(clue_scale, clue_scale, 1))
		end
	end

	-- Reposition existing column clues.
	for col, clues in ipairs(puzzle.col_clues) do
		local x = select(1, layout.cell_position(g, 1, col, puzzle.height))
		for index, node in ipairs(self.col_clue_nodes[col] or {}) do
			local y = g.col_clue_bottom + (#clues - index + 0.5) * g.clue_step
			gui.set_position(node, vmath.vector3(x, y, 0))
			gui.set_scale(node, vmath.vector3(clue_scale, clue_scale, 1))
		end
	end
end


local PUZZLE_STATUS_TEXT = {
	playing = "Solve the puzzle",
	completed = "Completed!",
	save_failed = "Completed! Progress not saved."
}

local function sync_ui(self)
	if not self.session then return	end

	local s = self.session
	gui.set_text(self.title, s.level.name)
	gui.set_text(self.status, PUZZLE_STATUS_TEXT[s.ui.status] or "")
	gui.set_enabled(self.button_next, s.ui.show_next)
end



local function open_level(self, level_id)
	if not puzzles.get(level_id) then
		print("Unknown level:", tostring(level_id))
		return false
	end

	self.drag = nil

	clear_grid(self)

	-- Release the old puzzle session.
	self.session = nil
	self.geometry = nil

	-- Schedule the next puzzle.
	self.pending_level_id = level_id
	self.pending_level_frames = 3

	gui.set_enabled(self.button_next, false)
	gui.set_text(self.title, "Loading...")
	gui.set_text(self.status, "")

	return true
end


local function load_pending_level(self)
	local level_id = self.pending_level_id
	if not level_id then return	end

	self.pending_level_id = nil
	self.pending_level_frames = nil

	self.session = session.new(level_id)
	rebuild_board(self)
	sync_ui(self)

	print("Opened level:", level_id)
end


local function paint_cell(self, row, col, state)
	if not self.session then return	end

	local result = session.paint(self.session, row,	col, state)
	if not result.changed then return end

	update_cell(self, row, col)
	update_clues(self, row, col)

	if result.completed_now then
		local s = self.session
		local saved = progress.complete(s.level_id)
		local can_advance = false

		if saved and s.next_level_id then
			local next_level, category = catalog.next_level(s.level_id)

			if next_level and category then
				can_advance = progress.category_unlocked(category.id)
			end
		end

		session.finish(s, saved, can_advance)
		sync_ui(self)

		self.drag = nil
	end
end


local function find_cell(self, x, y)
	if not self.session or not self.session.board then return nil, nil end

	for row = 1, self.session.board.height do
		for col = 1, self.session.board.width do
			local cell = self.cells[row][col]

			if gui.pick_node(cell, x, y) then
				return row, col
			end
		end
	end
	return nil, nil
end


local function begin_paint(self, action_id, x, y)

	local row, col = find_cell(self, x, y)

	if not row or self.session.completed then return false end

	local mark = action_id == TOUCH	and board.FILLED or board.CROSSED

	local current = self.session.board.cells[row][col]

	-- If the cell already has this mark, erase it.
	local target = current == mark and board.UNKNOWN or mark

	self.drag = {
		state = target,
		last_row = row,
		last_col = col,
		last_x = x,
		last_y = y,
	}

	paint_cell(self, row, col, target)

	return true
end

local function continue_paint(self, x, y)
	if not self.drag or self.session.completed then return end

	local drag = self.drag

	local dx = x - drag.last_x
	local dy = y - drag.last_y

	local distance = math.sqrt(dx * dx + dy * dy)

	-- Keep the sampling interval smaller than a cell.
	local spacing = math.min(12, self.geometry.cell_size / 3)

	local steps = math.max(1, math.ceil(distance / spacing))

	local start_x = drag.last_x
	local start_y = drag.last_y

	for i = 1, steps do
		local t = i / steps

		local px = start_x + dx * t
		local py = start_y + dy * t

		local row, col = find_cell(self, px, py)

		if row and (drag.last_row ~= row or drag.last_col ~= col) then
			drag.last_row = row
			drag.last_col = col

			paint_cell(self, row, col, drag.state)

			-- Victory can end the gesture.
			if self.session.completed then break end
		end
	end

	if self.drag then
		self.drag.last_x = x
		self.drag.last_y = y
	end
end


function init(self)
	msg.post(".", "acquire_input_focus")

	self.last_gui_width = gui.get_width()
	self.last_gui_height = gui.get_height()

	self.title = gui.get_node("title")
	self.status = gui.get_node("status")
	self.button_back = gui.get_node("button__back")
	self.button_next = gui.get_node("button__next")
	self.puzzle_canvas = gui.get_node("puzzle__canvas")

	self.nodes = {}
	self.cells = {}

	self.pending_level_id = nil
	self.pending_level_frames = nil

	self.session = nil
	self.drag = nil
end


function update(self, dt)
	if self.pending_level_id then
		self.pending_level_frames =	self.pending_level_frames - 1
		if self.pending_level_frames <= 0 then load_pending_level(self)	end
		return
	end
	
	local width = gui.get_width()
	local height = gui.get_height()
	if width ~= self.last_gui_width	or height ~= self.last_gui_height then
		self.last_gui_width = width
		self.last_gui_height = height
		update_board_layout(self)
		sync_ui(self)
	end
end


function on_message(self, message_id, message, sender)
	if message_id == OPEN_LEVEL then
		open_level(self, message.level_id)
	elseif message_id == LAYOUT_CHANGED and not self.pending_level_id then
		update_board_layout(self)
		sync_ui(self)
	end
end

function on_input(self, action_id, action)

	-- Pointer movement during a drag.
	if action_id == nil then
		if self.drag and action.x and action.y then
			continue_paint(self, action.x, action.y)
		end
		return
	end

	if action_id ~= TOUCH and action_id ~= CROSS then
		return
	end

	-- Stop painting on mouse release.
	if action.released then
		self.drag = nil
		return true
	end

	if not action.pressed then return end

	local x, y = action.x, action.y

	-- The Back button only responds to left click.
	if action_id == TOUCH and gui.pick_node(self.button_back, x, y) then
		msg.post(APP, "show_levels")
		return true
	end

	-- If session does not exist we do not need the rest
	if not self.session then return false end

	-- The `Next puzzle` button
	if action_id == TOUCH and self.session and self.session.ui.show_next and self.session.next_level_id and gui.pick_node(self.button_next, x, y) then
		open_level(self, self.session.next_level_id)
		return true
	end

	if self.drag then return true end

	-- Begin filling or crossing cells.
	return begin_paint(self, action_id, x, y)
end
