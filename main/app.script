local settings = require "systems.settings"

local SCREENS = {
	about = "#about_proxy",
	menu = "#menu_proxy",
	levels = "#levels_proxy",
	game = "#game_proxy",
	settings = "#settings_proxy",
}

local function load_screen(self, name)
	self.current_screen = name
	self.current_proxy = SCREENS[name]

	print("Loading screen:", name)
	msg.post(self.current_proxy, "load")
end

local function switch_screen(self, name)
	if not SCREENS[name] then
		print("Unknown screen:", name)
		return
	end

	if self.next_screen then
		return
	end

	if self.current_screen == name then
		return
	end

	self.next_screen = name

	if self.current_proxy then
		-- First unload the previous collection.
		msg.post(self.current_proxy, "unload")
	else
		-- Nothing loaded yet.
		self.next_screen = nil
		load_screen(self, name)
	end
end

function init(self)
	self.current_screen = nil
	self.current_proxy = nil
	self.next_screen = nil

	self.selected_category_index = nil
	self.selected_level_index = nil

	self.levels_return = nil

	settings.init()
	-- Required for input propagation to proxy worlds.
	msg.post(".", "acquire_input_focus")

	switch_screen(self, "menu")
end

function on_message(self, message_id, message, sender)

	-- Navigation requests
	if message_id == hash("show_menu") then
		self.levels_return = nil
		switch_screen(self, "menu")

	elseif message_id == hash("show_about") then
		switch_screen(self, "about")

	elseif message_id == hash("show_levels") then
		switch_screen(self, "levels")

	elseif message_id == hash("request_levels_state") then
		if self.levels_return then
			msg.post(sender, "restore_levels_state", self.levels_return)
			self.levels_return = nil
		end

	elseif message_id == hash("show_game") then
		self.selected_category_index = message.category_index
		self.selected_level_index = message.level_index
		self.levels_return = {
			category_index = message.category_index,
			scroll_fraction = message.scroll_fraction or 0
		}
		switch_screen(self, "game")

	elseif message_id == hash("show_settings") then
		switch_screen(self, "settings")

		-- Collection loaded
	elseif message_id == hash("proxy_loaded") then
		msg.post(sender, "init")
		msg.post(sender, "enable")

		if self.current_screen == "game" then
			msg.post("game:/game#game", "open_level", {
				category_index = self.selected_category_index,
				level_index = self.selected_level_index
			})
		end

		print("Screen ready:", self.current_screen)

		-- Collection unloaded
	elseif message_id == hash("proxy_unloaded") then
		self.current_screen = nil
		self.current_proxy = nil

		if self.next_screen then
			local next_screen = self.next_screen
			self.next_screen = nil
			load_screen(self, next_screen)
		end

	elseif message_id == hash("proxy_error") then
		print("Collection proxy error:", message.code)
	end
end
